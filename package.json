{
	"name": "@terrahop/svelte-utils",
	"version": "2.4.0",
	"license": "MIT",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"package:watch": "svelte-package -w",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint --max-warnings=0 --no-warn-ignored ./src"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./actions": {
			"types": "./dist/actions/index.d.ts",
			"svelte": "./dist/actions/index.js"
		},
		"./components": {
			"types": "./dist/components/index.d.ts",
			"svelte": "./dist/components/index.js"
		},
		"./stores": {
			"types": "./dist/stores/index.d.ts",
			"svelte": "./dist/stores/index.js"
		},
		"./util": {
			"types": "./dist/util/index.d.ts",
			"svelte": "./dist/util/index.js"
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": "2.0.0",
		"svelte": "5.0.0"
	},
	"devDependencies": {
		"@floating-ui/dom": "1.7.4",
		"@steeze-ui/heroicons": "2.4.2",
		"@steeze-ui/svelte-icon": "1.6.2",
		"@sveltejs/adapter-auto": "7.0.0",
		"@sveltejs/kit": "2.49.2",
		"@sveltejs/package": "2.5.7",
		"@sveltejs/vite-plugin-svelte": "6.2.1",
		"@tailwindcss/postcss": "4.1.18",
		"@terrahop/eslint-config-svelte": "github:Terrahop/eslint-config-svelte#v1.2.0",
		"daisyui": "5.5.14",
		"eslint": "9.39.2",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.13.1",
		"postcss": "8.5.6",
		"prettier": "3.7.4",
		"prettier-plugin-svelte": "3.4.1",
		"prettier-plugin-tailwindcss": "0.7.2",
		"publint": "0.3.16",
		"svelte": "5.46.0",
		"svelte-check": "4.3.4",
		"tailwindcss": "4.1.18",
		"typescript": "5.9.3",
		"typescript-svelte-plugin": "0.3.50",
		"vite": "7.3.0"
	}
}
